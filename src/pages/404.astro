---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
---

<PageLayout title="404 — Page Not Found" description="The page you are looking for does not exist.">
  <TopLayout>
    <div class="animate flex flex-col items-center justify-center py-24 text-center">
      <p class="text-6xl font-bold text-black dark:text-white">
        404
      </p>
      <p class="text-xl font-semibold text-black dark:text-white mt-4">
        Page Not Found
      </p>
      <p class="mt-2 opacity-75">
        The page you are looking for does not exist or has been moved.
      </p>
      <a href="/" class="mt-8 py-2 px-4 rounded text-sm border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend">
        Back to Home
      </a>
    </div>
  </TopLayout>
</PageLayout>
